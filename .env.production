# Database
APP_ENV=production
POSTGRES_USER=bidpivot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bidpivot
DATABASE_URL=postgresql+asyncpg://bidpivot:CHANGE_ME_STRONG_PASSWORD@postgres:5432/bidpivot

# Redis
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Qdrant
QDRANT_URL=http://qdrant:6333

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY
MINIO_BUCKET=bidpivot

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_64_CHARS
ENCRYPTION_KEY=CHANGE_ME_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ALLOW_PUBLIC_REGISTER=false
CLAMAV_HOST=

# LLM
LLM_BASE_URL=http://your-llm-server:11434/v1

# CORS
CORS_ORIGINS=["https://your-domain.com"]
